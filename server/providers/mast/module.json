{
  "name": "mast",
  "version": "git",
  "description": "Lay down the MAST source tree for the 'unit' role via tools/mast-clone.ps1 (one venv at <Top>\\.venv, repos at <Top>\\{common,unit,claude}), and register the mast-unit NSSM service.",
  "order": 2200,
  "command": "powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File \".\\provide-mast.ps1\" -AssetsRoot \".\" -Top \"C:\\MAST\\src\"",
  "commandfiles": [
    "provide-mast.ps1",
    "verify-mast.ps1"
  ],
  "verify": "powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File \".\\verify-mast.ps1\" -Top \"C:\\MAST\\src\" -Expect \"common,unit,claude\"",
  "repofiles": [
    "tools/mast-clone.ps1",
    "tools/mast-repos.tsv"
  ]
}
